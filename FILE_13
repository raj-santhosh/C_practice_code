// WAP reverse the all words in a FILE
#include<stdio.h>
#include<string.h>
void rev(char *s,int n)
{

        int i,j;
        char t;
        for(i=0,j=n-1;i<j;i++,j--)
        {
                t=s[i];
                s[i]=s[j];
                s[j]=t;
        }
}
int main(int argc,char *argv[])
{
        if(argc!=2)
        {
                printf("usage:./a.out fname..\n");
                return 1;
        }
        FILE *fp=fopen(argv[1],"r+");
        int i,j,len;
        char ch,s[50];
        while(fscanf(fp,"%s",s)==1)
        {
                for(len=0;s[len];len++);
                rev(s,len);
                fseek(fp,-len,SEEK_CUR);
                fprintf(fp,"%s ",s);
        }
        fclose(fp);
return 0;
}
