WAP in C to print and count perfect in array .
#include<stdio.h>
int main()
{
        int a[7]={3,4,5,6,7,28,9},i,j,ele,c=0;
        ele=sizeof(a)/sizeof(a[0]);
        int add=0;
        for(i=0;i<ele;i++)
        {       for(j=1;j<a[i];j++)
                {
                        if(!(a[i]%j))
                                add+=j;
                }
                if(a[i]==add)
                {
                        c++;
                        printf("%d ",a[i]);
                }
        }
        printf("count :%d\n",c);
return 0;
}
