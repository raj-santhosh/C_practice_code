WAP in c to replace prime index ele with 0 in array.
#include<stdio.h>
int main(){
        int a[8]={11,22,33,44,55,66,77,88};
        int ele,i,j,n,c;
        ele=sizeof(a)/sizeof(a[0]);
        for(i=0;i<ele;i++)
        {   c=0;
            for(j=2;j<=i;j++)
                  if(!(i%j))
                        c++;
                if(c==1)
                    a[i]=0;
        }
        for(i=0;i<ele;i++)
                printf("%d ",a[i]);
return 0;
}
