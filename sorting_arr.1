WAP sort ascending order in the array element
#include<stdio.h>
int main()       
{
        int a[5]={11,55,88,44,22},*p=a;
        int i,j,t,ele;
        ele=sizeof(a)/sizeof(a[0]);
        for(i=0;i<ele-1;i++)
        {  
                for(j=0 ;j<ele-1 -i ;j++) 
                {
                        if(a[j]<a[j+1])
                        {
                                  t    = a[j];
                                a[j]   = a[j+1];
                                a[j+1] = t;
                        }
                }
        }
        for(i=0 ;i<ele ;i++)
        printf("%d ",*p++);
return 0;
}
