WAP in C to delete duplicate elements from array .
#include<stdio.h>
int main(){
        int a[10]={3,3,2,9,4,4,2,1,6,6};
        int ele,i,j,k;
        ele=sizeof(a)/sizeof(a[0]);
        for(i=0;i<ele;i++)
        {
                for(j=i+1;j<ele;j++)
                {
                        if(a[i]==a[j])
                        {       //if(a[j]%2==0)  for even duplicate del

                                for(k=j ;k<ele-1 ;k++)
                                        a[k]=a[k+1];

                                ele--;
                                j--;    }
                }
        }
        for(i=0;i<ele;i++)
                printf("%d ",a[i]);
return 0;
}
