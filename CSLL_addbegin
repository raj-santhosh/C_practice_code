void addbegin(CSLL **ptr)
{
        CSLL *new,*last;
        new = malloc(sizeof(CSLL));
        printf("enter rollno name and marks.\n");
        scanf("%d %s %f\n",&new->rollno,new->name,&new->marks);

        if(*ptr==0)                // if no records
                new->next=new;
        else
        {
                new->next=*ptr;   // new next node is prev first node
                last=*ptr;        // started from first node

                while(last->next != *ptr)  //finding last node
                        last=last->next;
        }
        last->next=new;          //update last node next addr as new
        *ptr=new;                // finally update headptr
}
