#include<stdio.h>
#include<stdlib.h>
#define SIZE 5
int STACK[SIZE];
int TOP =-1;
void push(void);
void pop(void);
void display(void);

int main()
{
        int op;
        while(1)
        {
                printf("Enter the choice..\n");
                printf("1.Push\n2.Pop\n3.Dislplay\n4.exit\n");
                scanf("%d",&op);
                switch(op)
                {
                        case 1: push();         break;
                        case 2: pop();          break;
                        case 3: display();      break;
                        case 4: exit(0);
                }
        }
}
//----------------------------------------PUSH---------------------------------------
void push()
{
        if(TOP>=SIZE-1)
        {
                printf("Stack Overflow\n");
                return;
        }
        printf("Enter number to push in stack:");
        scanf("%d",&STACK[++TOP]);                // first increment TOP after add num
}
//------------------------------------------POP---------------------------------------
void pop()
{
        if(TOP<0)
        {
                printf("Stack is Underflow\n");
                return;
        }
        printf("Deleted num: %d",STACK[TOP--]);  //Delete after decrement TOP
}
//--------------------------------------DISPLAY---------------------------------------
void display()
{
        system("clear");
        if(TOP<0)
        {
                printf("Stack is Empty...\n");
                return;
        }
        for(int i=0; i<=TOP ;i++)
                printf("%d\n",STACK[i]);
}
