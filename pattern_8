WAP print pattern.
E D C B A
* D C B A
* * C B A
* * * B A
* * * * A
#include<stdio.h>
int main()
{
        int i,j;
        char ch;
        for(i=1;i<=5;i++)
        {       ch ='E';
              for(j=1;j<=5;j++)
              {      if(j<i)
                         printf("* ");
                      else
                        printf("%c ",ch);
                        ch--;
                }
                printf("\n");           
        }
return 0;
}
