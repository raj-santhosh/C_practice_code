WAP in C  to delete odd  elements from array .
#include<stdio.h>
int main()
{
        int a[6]={11,12,14,13,15,18};
        int ele,i,j;
        ele=sizeof(a)/sizeof(a[0]);
        for(i=0;i<ele;i++)
        {
                if(a[i]%2)
                {
                        for(j=i;j<ele-1;j++)
                                a[j]=a[j+1];
                        ele--;
                        i--;
                }
        }
        for(i=0 ;i<ele ;i++)
                printf("%d ",a[i]);
return 0;
}
