WAP using Singly Linked List to Store and Display Student Records using add_begin() function.

#include<stdio.h>
#include<stdlib.h>
typedef struct student
{
        int roll;
        char name[20];
        float marks;
        struct student *next;
}STT;

void add_begin(STT **);
void print(STT *);

int main()
{
        char op;
        STT *hptr=0;
        do
        {
                add_begin(&hptr);
                printf("Do you want to add one more student record\n");
                scanf(" %c",&op);
        }while((op=='y') || (op=='Y'));

        printf("Printing the records..\n");
        print(hptr);
}

void addBegin(SLL**ptr)
{
        SLL *new;
        new = malloc(sizeof(SLL));
        printf("Enter rollno,name and marks \n");
        scanf("%d %s %f",&new->rollno,new->name,&new->marks);
        new->next = *ptr;
        *ptr = new;
}
void printNode(SLL*ptr)
{       printf("\033[37;3m--------------------------\n");
        if(ptr==0)
        {       printf("No records found\n");
                printf("--------------------------\033[0m\n");
        return;
        }
        while(ptr)
        {
                printf("%d %s %f\n",ptr->rollno,ptr->name,ptr->marks);
