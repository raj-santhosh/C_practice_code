WAP sum of digits using recursive function.
#include<stdio.h>
int sum_digit(int n){
        if(n==0)
                return 0;
        else
                return (n%10)+sum_digit(n/10);

}
int main()
{
        int n;
        printf("enter a num:");
        scanf("%d",&n);
        printf("sum of digit:%d\n",sum_digit(n));
return 0;
}
