WAP in C to insert ‘p’ at 0th index,‘q’ at 1st index  in same string using goto.
#include<stdio.h>
int main(){
        char s[10]="1234567",ch1,ch2;
        int i,j,indx1,indx2,len;
        printf("enter index 1 2:");
        scanf("%d%d",&indx1,&indx2);
        printf("enter char 1 2:");
        scanf(" %c %c",&ch1,&ch2);

        for(len=0;s[len];len++);
        for(i=len+1;i>indx1 ;i--)
                s[i]=s[i-1];

        s[indx1]=ch1;
        for(i=len+1;i>indx2 ;i--)
                s[i]=s[i-1];

        s[indx2]=ch2;
        printf("%s",s);

return 0;
}
