Write a Program to Implement “rm” Command.
#include<stdio.h>
int main(int argc,char *argv[])
{
        if(argc!=2)
        {
                printf("Usage: ./a.out filename\n");
                return 0;
        }

        int r=remove(argv[1]);

        if(r==0)
                printf("The File is removed successfully\n");
        else
                printf("The File doesn't Exist\n");
}
