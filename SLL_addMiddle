Write a Program using Singly Linked List to Store and Display Student Records using addMiddle() function.
(Sorted Insertion Based on Roll)

#include<stdio.h>
#include<stdlib.h>
typedef struct student
{
        int roll;
        char name[20];
        float marks;
        struct student *next;
}STT;

void addMiddle(STT **);
void printNode(STT *);
void saveFile(SLL *ptr);
int main()
{
        char op;
        STT *headptr=0;
        do
        {
                addMiddle(&headptr);
                printf("Do you want to add one more student record\n");
                scanf(" %c",&op);
        }while((op=='y') || (op=='Y'));

        printf("Printing the records..\n");
        printNode(headptr);
        saveFile(headptr);
}

void addMiddle(SLL **ptr)
{
        SLL *new,*pos;
        new=malloc(sizeof(SLL));
        printf("Enter rollno name and marks\n");
        scanf("%d %s %f",&new->rollno,new->name,&new->marks);

        if((*ptr)==0 || (new->rollno < (*ptr)->rollno))
        {
                new->next=*ptr;
                *ptr=new;
        }
        else
        {
                pos=*ptr;
                while((pos->next!=0) && (new->rollno > pos->next->rollno))
                        pos = pos->next;
                new->next = pos->next;
                pos->next = new;
        }

}
void printNode(SLL*ptr)
{      
        if(ptr==0)
        {       printf("No records found\n");
        	return;
        }
        while(ptr)
        {
                printf("%d %s %f\n",ptr->rollno,ptr->name,ptr->marks);
                ptr=ptr->next;
        }
}
void saveFile(SLL*ptr)
{
        if(ptr==0)
        {
                printf("No records found\n");
                return;
        }
        FILE *fp=fopen("std.txt","w");
        while(ptr)
        {
                fprintf(fp,"%d %s %f\n",ptr->rollno,ptr->name,ptr->marks);
                ptr=ptr->next;
        }
        printf("Data saved in file\n");
        fclose(fp);
}
