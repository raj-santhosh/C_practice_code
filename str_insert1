WAP in C to insert a char at 2nd index in string
#include<stdio.h>
int main(){
        char ch,s[10]="abcdef";
        int i,j,indx,len;
          printf("enter index:");
          scanf("%d",&indx);
          ch='p';
            for(len=0;s[len];len++);
                for(i=len+1;i>indx;i--)
                      s[i]=s[i-1];

              s[indx]=ch;
        printf("%s",s);
}
