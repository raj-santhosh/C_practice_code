WAP in C to delete perfect number from array .
#include<stdio.h>
int main(){
        int a[6]={6,7,28,6,5,24};
        int i,j,add,ele;
        ele=sizeof(a)/sizeof(a[0]);
        for(i=0;i<ele;i++)
        {       add=0;
                for(j=1;j<a[i];j++)
                        if(!(a[i]%j))
                                add+=j;
                if(a[i]==add)
                {
                        for(j=i;j<ele-1;j++)
                                a[j]=a[j+1];
                        ele--;
                        i--;
                }
        }
        for(i=0;i<ele;i++)
                printf("%d ",a[i]);
return 0;
}
