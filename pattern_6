WAP print pattern
    1
   ab
  123
 abcd
12345

#include<stdio.h>
int main()
{       int i,j,k;
        for(i =0 ;i<5 ;i++)
        {
                for(k=0; k<4-i ;k++)
                printf(" ");
                for(j=0; j<=i ;j++)
                        if(i%2)
                             printf("%c",'a'+j);
                        else
                                printf("%d",1+j);
                printf("\n");
        }
}
