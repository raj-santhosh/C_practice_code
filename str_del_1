WAP in C to delete duplicate char from string.
#include<stdio.h>
int main(){
        char s[20]="abc abc ppp 122";
        int i,j,k;
        for(i=0;s[i];i++)
        {       for(j=i+1;s[j];j++)
                        if(s[i]==s[j])
                        {               for(k=j;s[k];k++)
                                        s[k]=s[k+1];
                              j--;
                        }
        }
        printf("%s",s);
return 0;
}
