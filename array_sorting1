WAP sorting 1st 4 element in the array.
#include<stdio.h>
int main(){
        int a[7]={5,3,1,2,1,9,6};
        int i,j,ele,t;
        ele =sizeof(a)/sizeof(a[0]);

        for(i=0;i<ele-1 ;i++)
        {
                for(j=0 ;j<3 ;j++)
                {
                        if(a[j]<a[j+1])
                        {
                                t  =a[j];
                                a[j]=a[j+1];
                                a[j+1]=t;
                        }
                }
        }

        for(i=0;i<ele;i++)
                printf("%d ",a[i]);
return 0;
}
