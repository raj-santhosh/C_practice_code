WAP singly linked list sortData() sort by rollno.

void sortData(SLL *ptr)
{
        if(ptr==0)
        {
                printf("No records present.\n");
                return;
        }

        SLL *p1=ptr,*p2,t;
        int i,j,c=countNode(ptr);
        for(i=0;i<c-1;i++)
        {
                p2=p1->next;
                for(j=0;j<c-1-i;j++)
                {
                        if(p1->rollno > p2->rollno)  // for nameSort -> if(strcmp(p1->name,p2->name)>0)
                        {
                                t.rollno = p1->rollno;
                                t.marks = p1->marks;
                                strcpy(t.name,p1->name);

                                p1->rollno = p2->rollno;
                                p1->marks = p2->marks;
                                strcpy(p1->name,p2->name);

                                p2->rollno = t.rollno;
                                p2->marks = t.marks;
                                strcpy(p2->name,t.name);

                        }
                        p2=p2->next;
                }
                p1=p1->next;
        }
}
