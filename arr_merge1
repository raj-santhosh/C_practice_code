WAP in C to merge 2 array into 3rd array .
#include<stdio.h>
int main(){
        int a[3]={1,5,7},b[3]={11,22,33},c[6];
        int i,j=0;
        for(i=0;i<3;i++)
        {
                c[j++]=a[i];
                c[j++]=b[i];
        }
        for(i=0;i<6;i++)
                printf("%d ",c[i]);
return 0;
}
