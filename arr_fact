WAP in C to store factorial of array in another array.
#include<stdio.h>
int main()
        int a[4]={4,5,6,4},b[4];
        int ele,i,j,fact;
        ele=sizeof(a)/sizeof(a[0]);

        for(i=0;i<ele;i++)
        {
                fact=1;
                for(j=1;j<=a[i];j++)
                        fact=fact*j;

            b[i]=fact;
        }
        for(i=0;i<ele;i++)
                printf("%d ",b[i]);
return 0;
