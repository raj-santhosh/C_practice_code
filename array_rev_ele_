WAP reverse the element in array.
i/p : int a[5]={10,20,30,40,50};
o/p : 50 40 30 20 10  

#include<stdio.h>
int main()
{
        int a[5];
        int i,ele,j,t;
        ele = sizeof(a)/sizeof(a[0]);

        printf("Enter arra ele:");
        for(i=0 ;i<ele ;i++)
                scanf("%d",&a[i]);
        printf("\n");

        for(i=0 ,j=ele-1 ;i<j ;i++ ,j--)
        {
                t    = a[i];
                a[i] = a[j];
                a[j] = t;
        }

        for(i=0 ;i<ele ;i++)
                printf("%d ",a[i]);
return 0;
}
