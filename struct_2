//WAP allocate Dynamic memory for store five student records scan and print it.
#include<stdio.h>
#include<stdlib.h>
typedef struct st{
        int rollno;
        char name[10];
        float marks;
}ST;
int main(){
        ST *p[5];
        int i;
        for(i=0;i<5;i++)
                p[i]=malloc(sizeof(struct st));
            if(p==0)
            {
                    printf("Malloc failed ...\n");
                    return 1;
            }
        for(i=0;i<5;i++)
        {
                printf("enter roll no:");
                scanf("%d",&p[i]->rollno);
                printf("enter name:");
                scanf("%s",p[i]->name);
                printf("enter marks:");
                scanf("%f",&p[i]->marks);
        }
        for(i=0;i<5;i++)
                printf("%d %s %f \n",p[i]->rollno,p[i]->name,p[i]->marks);
return 0;
}
