WAP in C to shift all -ve elements to right side in same array.
#include<stdio.h>
int main()
{
        int a[7]={-1,22,3,-4,-8,33,77};
        int ele,i,j,t;
        ele=sizeof(a)/sizeof(a[0]);
        for(i=0;i<ele-1;i++)
        {
                if(a[i]<0 && a[i+1]>0)
                {
                        t=a[i];
                        a[i]=a[i+1];
                        a[i+1]=t;
                        i=0;
                }

        }
        for(i=0;i<ele;i++)
                printf("%d ",a[i]);
return 0;
}
