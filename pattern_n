WAP print num pattern.
      3
    3 6
  3 6 9
3 6 9 12
#include<stdio.h>
int main()
{
        int num,i,j,sp,r;
        printf("enter a row:");
        scanf("%d",&r);
        for(i=1;i<=r;i++)
        {
                for(sp=1;sp <= r-i;sp++)
                {
                        printf("  ");
                }
                num=3;
                for(j=1;j<=i;j++)
                {
                        printf("%d ",num);
                        num+=3;
                }
                printf("\n");

        }
return 0;
}
