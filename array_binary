WAP print binary in array element.
#include<stdio.h>
int main(){
        int a[5]={10,100,1000,100,10},i,pos;
        int *p=a;
        for(i=0 ;i<5;i++)
        {
                for(pos=31;pos>=0;pos--)
                        printf("%d",*(p+i)>>pos&1);
                if(pos%8==0)
                        printf(" ");
                printf("\n");
        }
return 0;
}
