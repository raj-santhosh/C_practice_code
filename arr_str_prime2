WAP in C to store prime index ele in another array.
#include<stdio.h>
int main(){
        int a[8]={11,22,33,44,55,66,77,88};
        int ele,i,j,b[8],k=0,c=0;
        ele=sizeof(a)/sizeof(a[0]);
        for(i=0;i<ele;i++)
        {
                for(j=2;j<=i;j++)
                {
                        if(!(i%j))
                                break;
                }
                if(i==j)
                {
                        b[k++]=a[i];
                        c++;
                }
        }
        for(i=0;i<c;i++)
                printf("%d ",b[i]);
return 0;
}
