WAP in C to sort the string  in ascending order using while loop only .
#include<stdio.h>
int main(){
        char s[10]="Aa1Bb2Cc3",t;
        int i=0,j;
        while(s[i])
        {        j=1+i;
                while(s[j])
                {
                        if(s[i]>s[j])
                        {
                                t=s[i];
                                s[i]=s[j];
                                s[j]=t;
                        }
                        j++;
                }
                i++;
        }
        printf("%s",s);
return 0;
}
