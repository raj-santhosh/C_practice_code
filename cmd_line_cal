#include<stdio.h>
#include<stdlib.h>
int main(int argc ,char**argv)
{
        if(argc!=4)
        {       printf("usage:<num1> <operator> <num2>");
                return 1;
        }
        int a,b;
        char op;
        a=atoi(argv[1]);
        op=argv[2][0];
        b=atoi(argv[3]);
        switch(op)
        {
                case '+':
                        printf("addition :%d\n",a+b);
                        break;
                case '-':
                        printf("subtraction :%d\n",a-b);
                        break;
                case '*':
                        printf("multiplication :%d\n",a*b);
                        break;
                case '/':
                        printf("Division :%d\n",a/b);
                        break;
        }
        return 0;
}
