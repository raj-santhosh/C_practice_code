#define SET_BIT(num,pos) num= num|(1<<pos)
#define CLEAR_BIT(num,pos) num= num&~(1<<pos)
#define TOGGLE_BIT(num,pos) num= num^(1<<pos)
void main()
{
  int num=100,pos=4;
  printf("Before=%d\n",num);
  SET_BIT(num,pos);
