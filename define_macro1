//----------------------------------SWAP two integers--------------------
#include<stdio.h>
#define SWAP(a,b) { int t;\
                        t=a;\
                        a=b;\
                        b=t; }
int main()
{
        int i=10,j=20;
        SWAP(i,j);
        printf("%d %d\n",i,j);
        SWAP(i,j);       // if again call same macro in same block, it replaced "translater give error" redeclared,
                        //it overcome grouping it {int t;\ t=a; ,.. }  

}
//------------------------------Any data type replaced-----------------------
#include<stdio.h>
#define SWAP(a,b,type) { type t;\
                        t=a;\
                        a=b;\
                        b=t; }
int main()
{
        float i=23.4,j=13.8;
        SWAP(i,j,float);
        printf("%f %f\n",i,j);
        SWAP(j,i,float);
}
//----------------------------SET,CLEAR and Toggle a BIT ------------------------------
