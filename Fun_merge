8.WAP in C using function to merge 2 array data in 3rd  array.
#include<stdio.h>
void mer_arr(int *a,int *b,int*c,int ele1,int ele2,int ele3)
{
        int i,j,k;
        for(i=0,k=0;i<ele1;i++)
        {
                c[k++]=a[i];
                c[k++]=b[i];
        }

}
int main()
{
        int a[3]={2,3,4},b[3]={11,22,33},c[6];
        int ele1,ele2,ele3,i;
        ele1=sizeof(a)/sizeof(a[0]);
        ele2=sizeof(b)/sizeof(b[0]);
        ele3=sizeof(c)/sizeof(c[0]);
        mer_arr(a,b,c,ele1,ele2,ele3);

        for(i=0;i<ele3;i++)
                printf("%d ",c[i]);
}
