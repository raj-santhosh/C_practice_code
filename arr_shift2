WAP in C to shift all odd elements to right side in same array.
#include<stio.h>
int main(){
        int a[7]={11,22,22,44,55,33,88};
        int ele,i,j,t;
        ele=sizeof(a)/sizeof(a[0]);
        for(i=0;i<ele-1;i++)
        {
                for(j=0;j<ele-1;j++)
                {
                        if(a[j]%2)
                        {
                                t=a[j];
                                a[j]=a[j+1];
                                a[j+1]=t;

                        }
                }
        }
        for(i=0;i<ele;i++)
                printf("%d ",a[i]);
return 0;
}
