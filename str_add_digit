5.WAP  in C  to add digits in string using char pointer.
#include<stdio.h>
int add_char(char *p)
{
        int i,sum=0;
        for(i=0;p[i];i++)
        {       if(p[i]>='0' && p[i]<='9')
                        sum+= p[i]-'0';      
        }
  return sum;
}
int main()
{       char s[20]="123 hello by6";
        int sum;
        sum=add_char(s);
        printf("sum:%d",sum);
return 0;
}
