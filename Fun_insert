7.WAP in C using function to insert num in array at given particular location (index).
#include<stdio.h>
void insert_arr(int *a,int ele,int n,int pos)
{
        int i;
        for(i=ele-1;i>pos;i--)
                a[i]=a[i-1];

        a[pos]=n;
}
int main(){
        int a[6]={-1,2,3,-5,-7},n,pos;
        int ele,i;
        printf("enter index:");
        scanf("%d",&pos);
        printf("enter number:");
        scanf("%d",&n);

        ele=sizeof(a)/sizeof(a[0]);
        insert_arr(a,ele,n,pos);

        for(i=0;i<ele;i++)
                printf("%d ",a[i]);
return 0;
}
