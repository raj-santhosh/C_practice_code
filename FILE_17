Write a program to understand fscanf() operation
#include<stdio.h>
int main()
{
        char ch;
        int x;
        float f;
        char a[20];
        FILE *fp=fopen("DATA.txt","r");
        if(fp==NULL)
        {
                printf("File doesn't exist\n");
                return 0;
        }
        fscanf(fp,"%c %d %f %s",&ch,&x,&f,a);
        printf("ch=%c\n x=%d\n f=%f\n a=%s\n",ch,x,f,a);
}
