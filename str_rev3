WAP in C to reverse last word in string
#include<stdio.h>
int main(){
        char s[20]="vector india 123";
        char *p,*q,t;
        int i,j;
        
        for(j=0;p[j];j++); //find string length after get last word
        q=s+j-1;
        for(i=j-1;p[i]!=' ';i--); // find last to first space 
        p=s+i+1;
        while(p<q)
        {       t=*p;
                *p=*q;
                *q=t;
                  p++;
                  q--;
        }
        printf("%s",s);
return 0;
}
