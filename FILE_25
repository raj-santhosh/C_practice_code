Write a program to Write the Structure data into a file using fwrite()
#include<stdio.h>
struct st
{
        char ch;
        int x;
        float f;
        char a[20];
}v={'S',13,23.5,"Dragon"};
int main()
{
        FILE *fp=fopen("data","w");
        fwrite(&v,sizeof(struct st),1,fp);
        fclose(fp);
}
