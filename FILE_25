Write a program to understand the fread() operation

#include<stdio.h>
struct st
{
        char ch;
        int x;
        float f;
        char a[20];
}v;
int main()
{
        FILE *fp=fopen("data","r");
        if(fp==NULL)
        {
                printf("file not present...\n");
                return 0;
        }
        fread(&v,sizeof(struct st),1,fp);
        printf("v.ch = %c\n",v.ch);
        printf("v.x = %d\n",v.x);
        printf("v.f = %f\n",v.f);
        printf("v.a = %s\n",v.a);
return 0;
}
